# ======== Copy thành .env (KHÔNG commit .env) ========

# ---- LLM (ai_core) ----
# openrouter | openai | anthropic | ollama  (xem ai_core/ai_core/llm.py)
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-5.4-mini
LLM_API_KEY=sk-or-...
# Chỉ demo bằng hồ sơ giả, không dùng dữ liệu bệnh nhân thật:
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Nếu dùng OpenAI trực tiếp: LLM_PROVIDER=openai, LLM_MODEL=gpt-5.4-mini, key OpenAI.
# Nếu dùng Anthropic trực tiếp: LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5, key Anthropic.
# Embedding cho RAG: "local" (sentence-transformers, offline) | "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Nếu EMBEDDING_PROVIDER=openai, đặt EMBEDDING_MODEL=text-embedding-3-small và key OpenAI riêng.
# EMBEDDING_API_KEY=
VECTOR_STORE_DIR=./ai_core/data/vector_store
# Số đoạn guideline đưa vào mỗi câu trả lời (RAG lai BM25 + vector)
RAG_TOP_K=6

# ---- Backend ----
# PostgreSQL (khuyến nghị) hoặc SQLite cho dev nhanh
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/oncoscreen
# DATABASE_URL=sqlite:///./dev.db
# Bắt buộc đổi khi dùng PostgreSQL: ≥ 32 ký tự ngẫu nhiên, nếu không backend từ chối khởi động.
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000
# true = backend dùng MockAgent thay vì gọi LLM thật (để dev backend/frontend không cần key)
USE_MOCK_AGENT=true
# Scheduler nhắc lịch: chạy mỗi N giây (mô phỏng; production sẽ là hàng ngày)
REMINDER_TICK_SECONDS=60

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# true = frontend dùng fixtures trong src/mocks thay vì gọi backend
NEXT_PUBLIC_USE_MOCK_API=false
